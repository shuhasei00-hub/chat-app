rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ① 決済の記録: artifacts/{appId}/server/data/payments/{ref} ──────────────
    // 書き込みはサーバー(Cloudflare Workers)だけ（サービスアカウントはルールを無視できる）。ブラウザからは書けません。
    // 読み取りは本人の分だけ（アプリの「チャージ履歴」「支払い票」表示用）。
    // ★ 以前は public/data/payments に置いていたため、利用者が「偽の支払い記録」を作って無料でコインを得られる穴がありました。
    match /artifacts/{appId}/server/data/payments/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── ② サーバー専用領域: artifacts/{appId}/server/data/ の上記以外（プッシュ購読・Webhookトークン・リマインダー）──
    // どのルールにも一致しない = ブラウザからは読み書きできません。
    // ★ ここを許可するルール（例: match /{document=**} で全許可）を足さないでください。購読情報やWebhookのURLが漏れます。

    // ── ③ 既存アプリの公開データ: artifacts/{appId}/public/data/ ──────────────────
    // 既存アプリは users / chats / posts などをここに保存します。サインイン済みなら読み書き可（従来どおり）。
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

// ── 既知の制限（コイン残高） ─────────────────────────────────────────────────────
// users/{uid}.wallet は、ゲーム・送金・スタンプ購入などがブラウザから直接書き換える作りのままです。
// そのため、ブラウザの開発者ツールから自分の残高を増やすことができます。
//   ・チャージ（実際のお金）の入金処理自体は、サーバーだけが実行し、改ざんできません。
//   ・ただし「購入したコイン」と「無料で増やせるコイン」は区別されません。
// 完全に防ぐには、wallet の増減をすべてサーバー処理に移す必要があります（README「既知の制限」参照）。
