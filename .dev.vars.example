# ローカル(wrangler pages dev)用。本番は Cloudflare Pages の「設定 > 環境変数」に同じ名前で登録（Secret推奨）
# このファイルを .dev.vars にコピーして値を入れてください。.dev.vars は Git に入れないこと。

# --- 共通（決済でウォレットへ入金するために必須）---
FIREBASE_API_KEY=            # src/App.js の firebaseConfig.apiKey と同じ値
FIREBASE_PROJECT_ID=chat-app-c17bf
APP_ID=messenger-app-v9-integrated
FIREBASE_SERVICE_ACCOUNT=    # Firebaseコンソール > サービスアカウント > 新しい秘密鍵 のJSONを1行で貼る
APP_URL=                     # 例 https://your-app.pages.dev （省略時はアクセス元のURL）

# --- ① Stripe（カード / コンビニ / PayPay）---
STRIPE_SECRET_KEY=
STRIPE_METHODS=card,konbini  # PayPayを有効化したら card,konbini,paypay

# --- ② KOMOJU（コンビニ各社 / Pay-easy / 銀行振込 / PayPay / カード）---
KOMOJU_SECRET_KEY=
KOMOJU_PAYMENT_TYPES=konbini,credit_card,pay_easy,bank_transfer,paypay

# --- ③ PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox           # 本番は live

# --- ④ Square ---
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox           # 本番は production

# --- ⑤ PAY.JP (v2 Checkout) ---
PAYJP_SECRET_KEY=
PAYJP_WEBHOOK_TOKEN=         # ダッシュボードの「発信元トークン」(任意)
